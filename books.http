### Books - Book / Genre / Author / Publisher endpoints
### Run each request by clicking the ▶ next to "###" (Android Studio / IntelliJ).

@host = http://localhost:8080

############################################
### BOOKS
############################################

### List all books (200 - genre/author/publisher nested)
GET {{host}}/api/books
Accept: application/json

### Get a book by id (200)
GET {{host}}/api/books/1
Accept: application/json

### Get a non-existent book (404 Not Found)
GET {{host}}/api/books/9999
Accept: application/json

### Create a book (201 - genreId/authorId/publisherId must exist)
POST {{host}}/api/books
Content-Type: application/json

{
  "name": "Murder on the Orient Express",
  "genreId": 1,
  "authorId": 1,
  "publisherId": 1,
  "publishedDate": "1934-01-01",
  "pageCount": 256,
  "language": "en"
}

### Create a book with a non-existent reference (404 - genreId does not exist)
POST {{host}}/api/books
Content-Type: application/json

{
  "name": "Ghost",
  "genreId": 999,
  "authorId": 1,
  "publisherId": 1
}

### Invalid create (400 - empty name, missing ids, negative pageCount)
POST {{host}}/api/books
Content-Type: application/json

{
  "name": "",
  "pageCount": -5
}

### Update a book (200 - full replacement)
PUT {{host}}/api/books/1
Content-Type: application/json

{
  "name": "The Hobbit (revised)",
  "genreId": 1,
  "authorId": 1,
  "publisherId": 1,
  "publishedDate": "1937-09-21",
  "pageCount": 320,
  "language": "en"
}

### Delete a book (204)
DELETE {{host}}/api/books/1

############################################
### GENRES
############################################

### List genres (200)
GET {{host}}/api/genres
Accept: application/json

### Get a genre by id (200)
GET {{host}}/api/genres/1
Accept: application/json

### Create a genre (201)
POST {{host}}/api/genres
Content-Type: application/json

{
  "name": "Mystery"
}

### Update a genre (200)
PUT {{host}}/api/genres/1
Content-Type: application/json

{
  "name": "Crime"
}

### Delete a genre (204 - or 409 if still referenced by a book)
DELETE {{host}}/api/genres/1

############################################
### AUTHORS
############################################

### List authors (200)
GET {{host}}/api/authors
Accept: application/json

### Get an author by id (200)
GET {{host}}/api/authors/1
Accept: application/json

### Create an author (201)
POST {{host}}/api/authors
Content-Type: application/json

{
  "name": "Agatha Christie"
}

### Update an author (200)
PUT {{host}}/api/authors/1
Content-Type: application/json

{
  "name": "J.R.R. Tolkien"
}

### Delete an author (204 - or 409 if still referenced by a book)
DELETE {{host}}/api/authors/1

############################################
### PUBLISHERS
############################################

### List publishers (200)
GET {{host}}/api/publishers
Accept: application/json

### Get a publisher by id (200)
GET {{host}}/api/publishers/1
Accept: application/json

### Create a publisher (201 - website optional)
POST {{host}}/api/publishers
Content-Type: application/json

{
  "name": "Collins Crime Club",
  "website": "https://example.com"
}

### Update a publisher (200)
PUT {{host}}/api/publishers/1
Content-Type: application/json

{
  "name": "Allen & Unwin",
  "website": "https://www.allenandunwin.com"
}

### Delete a publisher (204 - or 409 if still referenced by a book)
DELETE {{host}}/api/publishers/1
